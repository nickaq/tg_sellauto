BOT_TOKEN=
# Telegram user_id через запятую (узнать: написать боту в личку /myid)
ADMIN_IDS=
MANAGER_IDS=
# Необязательно: рабочая группа для уведомлений (отрицательное число, -100...)
MANAGERS_CHAT_ID=
# Группы с постами: числовой ID или @username
SALES_CHAT_ID=@master_vadya
AUCTION_CHAT_ID=@master_vadya_auction
TIMEZONE=Asia/Tbilisi
DB_PATH=data/mv_auto.db
# Необязательно: разбор объявлений нейросетью (ключ: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Временно скрыть опции (1 — скрыть, 0 — показать), нужен перезапуск бота
HIDE_AI=0
HIDE_AUCTION=0
